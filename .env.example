# Obrigatório em produção: chave HMAC do cookie de sessão.
# 32+ bytes aleatórios, fora do repo. Trocar a chave invalida as partidas em
# andamento (todo mundo recomeça o dia) — não rotacione sem necessidade.
#   openssl rand -base64 32
ORDLE_SECRET=

# Cor litúrgica do dia, pela API do Caminho Anglicano:
#   GET https://api.caminhoanglicano.com.br/api/v1/calendar/:ano/:mes/:dia
#       ?preferences[prayer_book_code]=loc_2015
#
# A API exige verificação de app. O valor é o APP_INTERNAL_IDENTIFIER do app
# Flutter — mantenha fora do repo, mesmo já estando embutido no cliente.
# Sem chave (ou com 401, timeout, rede fora), o jogo cai no cálculo local de
# liturgy.ts e segue rodando.
ORDLE_LITURGY_KEY=

# Só se precisar sair dos padrões.
# ORDLE_LITURGY_HEADER=X-App-Internal-Id
# ORDLE_LITURGY_PRAYER_BOOK=loc_2015

# Supabase (o service role key fica somente no servidor; nunca o exponha ao
# client ou ao repositório).
NUXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=
