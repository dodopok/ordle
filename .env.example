# Obrigatório em produção: chave HMAC do cookie de sessão.
# 32+ bytes aleatórios, fora do repo. Trocar a chave invalida as partidas em
# andamento (todo mundo recomeça o dia) — não rotacione sem necessidade.
#   openssl rand -base64 32
ORDLE_SECRET=

# Opcional: Estêvão API para a cor litúrgica do dia. O gameId (YYYY-MM-DD) é
# concatenado no fim da URL. Sem isso, o cálculo local de server/utils/liturgy.ts
# assume — a cor sai certa nas estações e nas festas principais.
# ORDLE_LITURGY_API=https://exemplo.app/api/liturgical-day?date=
